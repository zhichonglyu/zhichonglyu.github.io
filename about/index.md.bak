<style>
/* ========== HERO ========== */
.about-hero{position:relative;overflow:hidden;background:linear-gradient(135deg,#2c4a7a 0%,#4a6fa5 50%,#6b8dc7 100%);color:#fff;padding:32px 32px 28px;border-radius:16px;margin-bottom:32px;box-shadow:0 8px 28px rgba(74,111,165,.25);display:flex;gap:28px;align-items:center;flex-wrap:wrap}
.about-hero::before{content:"";position:absolute;top:-60px;right:-60px;width:220px;height:220px;background:radial-gradient(circle,rgba(255,255,255,.2),transparent 70%);border-radius:50%}
.about-hero::after{content:"";position:absolute;bottom:-80px;left:40%;width:280px;height:280px;background:radial-gradient(circle,rgba(240,192,64,.16),transparent 70%);border-radius:50%}
[data-theme="dark"] .about-hero{background:linear-gradient(135deg,#1e2d47 0%,#2c3e5a 50%,#3a4f72 100%)}
.about-avatar{position:relative;z-index:2;flex-shrink:0}
.about-avatar img{width:130px;height:130px;border-radius:50%;border:4px solid rgba(255,255,255,.3);box-shadow:0 6px 20px rgba(0,0,0,.2);object-fit:cover;transition:transform .4s}
.about-avatar img:hover{transform:scale(1.05) rotate(3deg)}
.about-hero-text{position:relative;z-index:2;flex:1;min-width:260px}
.about-hero h1{color:#fff!important;margin:0 0 6px!important;font-size:2.1em;border:none!important;letter-spacing:.5px}
.about-hero .subtitle{opacity:.95;font-size:1.02em;margin-bottom:16px;line-height:1.5}
.about-hero .meta{display:flex;flex-wrap:wrap;gap:10px;font-size:.92em;margin-bottom:14px}
.about-hero .meta span{background:rgba(0,0,0,.28);color:#fff;padding:5px 14px;border-radius:20px;font-weight:500;letter-spacing:.2px}
.about-social{display:flex;gap:10px;flex-wrap:wrap}
.about-social a{display:inline-flex;align-items:center;gap:6px;background:#fff;color:#2c4a7a;padding:6px 14px;border-radius:22px;font-size:.88em;text-decoration:none;transition:all .25s;font-weight:600;box-shadow:0 2px 6px rgba(0,0,0,.15)}
.about-social a:hover{background:#f0c040;color:#333;transform:translateY(-2px);box-shadow:0 4px 12px rgba(240,192,64,.5)}

/* ========== STATS ========== */
.about-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:32px}
.about-stats .stat{background:var(--card-bg,#fff);border-radius:12px;padding:18px 12px;text-align:center;box-shadow:0 2px 10px rgba(0,0,0,.06);transition:all .3s;border-top:3px solid #4a6fa5}
.about-stats .stat:hover{transform:translateY(-4px);box-shadow:0 8px 20px rgba(74,111,165,.2)}
[data-theme="dark"] .about-stats .stat{background:#242731;border-top-color:#6b8dc7}
.about-stats .stat .num{font-size:1.9em;font-weight:700;color:#4a6fa5;line-height:1;margin-bottom:4px;display:block}
[data-theme="dark"] .about-stats .stat .num{color:#8badd4}
.about-stats .stat .label{font-size:.82em;color:#888;letter-spacing:.3px}
[data-theme="dark"] .about-stats .stat .label{color:#aaa}
@media(max-width:700px){.about-stats{grid-template-columns:repeat(2,1fr)}}

/* ========== SECTIONS ========== */
.about-section{background:var(--card-bg,#fff);border-left:4px solid #4a6fa5;padding:18px 26px 20px;margin-bottom:26px;border-radius:8px;transition:all .3s;box-shadow:0 2px 8px rgba(0,0,0,.04)}
.about-section:hover{box-shadow:0 6px 18px rgba(74,111,165,.12)}
[data-theme="dark"] .about-section{background:#242731;border-left-color:#6b8dc7}
.about-section h2{border:none!important;margin:0 0 14px!important;color:#4a6fa5;font-size:1.35em;display:flex;align-items:center;gap:10px;padding-bottom:10px;border-bottom:2px dashed rgba(74,111,165,.15)!important}
[data-theme="dark"] .about-section h2{color:#8badd4;border-bottom-color:rgba(139,173,212,.2)!important}
.about-section p,.about-section ul{margin:8px 0}
.about-section ul{padding-left:22px}
.about-section ul li{margin-bottom:6px;line-height:1.7}

/* ========== TIMELINE (FLAT) ========== */
.timeline{position:relative;padding:6px 0 6px 28px}
.timeline::before{content:"";position:absolute;left:8px;top:10px;bottom:10px;width:2px;background:linear-gradient(180deg,#4a6fa5,#8ea8d1)}
.ti{position:relative;padding:10px 16px;margin-bottom:10px;background:rgba(74,111,165,.05);border-radius:8px;transition:all .3s}
.ti:hover{background:rgba(74,111,165,.11);transform:translateX(4px)}
.ti::before{content:"";position:absolute;left:-26px;top:16px;width:12px;height:12px;border-radius:50%;background:#4a6fa5;border:3px solid var(--card-bg,#fff);box-shadow:0 0 0 2px #4a6fa5}
[data-theme="dark"] .ti{background:rgba(139,173,212,.07)}
[data-theme="dark"] .ti:hover{background:rgba(139,173,212,.15)}
[data-theme="dark"] .ti::before{background:#8badd4;border-color:#242731;box-shadow:0 0 0 2px #8badd4}
.ti-date{display:inline-block;font-weight:600;color:#4a6fa5;margin-right:10px;font-size:.92em}
[data-theme="dark"] .ti-date{color:#8badd4}
.ti-main{font-weight:600;font-size:1em}
.ti-sub{color:#666;font-size:.9em;margin-left:4px}
[data-theme="dark"] .ti-sub{color:#aaa}

/* ========== INTERESTS ========== */
.interests{display:flex;flex-wrap:wrap;gap:10px;margin:6px 0}
.interests .chip{background:linear-gradient(135deg,rgba(74,111,165,.1),rgba(107,141,199,.18));padding:6px 14px;border-radius:20px;font-size:.92em;border:1px solid rgba(74,111,165,.2);transition:all .25s}
.interests .chip:hover{background:linear-gradient(135deg,#4a6fa5,#6b8dc7);color:#fff;transform:translateY(-2px);box-shadow:0 4px 12px rgba(74,111,165,.3)}
[data-theme="dark"] .interests .chip{background:linear-gradient(135deg,rgba(139,173,212,.12),rgba(139,173,212,.2));border-color:rgba(139,173,212,.3)}

/* ========== PAPERS ========== */
.pub-tabs{display:flex;gap:6px;margin:8px 0 14px;flex-wrap:wrap;border-bottom:2px solid rgba(74,111,165,.15);padding-bottom:0}
.pub-tab{background:transparent;border:none;padding:8px 18px;font-size:.95em;color:#666;cursor:pointer;border-radius:8px 8px 0 0;transition:all .25s;font-weight:500;position:relative;bottom:-2px;border-bottom:2px solid transparent}
.pub-tab:hover{color:#4a6fa5;background:rgba(74,111,165,.06)}
.pub-tab.active{color:#4a6fa5;border-bottom-color:#4a6fa5;font-weight:600}
[data-theme="dark"] .pub-tab{color:#aaa}
[data-theme="dark"] .pub-tab:hover,[data-theme="dark"] .pub-tab.active{color:#8badd4;border-bottom-color:#8badd4}
.pub-panel{display:none}
.pub-panel.active{display:block;animation:fadeIn .3s}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.pub-card{background:rgba(74,111,165,.04);border-left:3px solid #4a6fa5;padding:12px 16px;margin-bottom:10px;border-radius:6px;transition:all .3s;line-height:1.7}
.pub-card:hover{background:rgba(74,111,165,.1);transform:translateX(4px);box-shadow:0 4px 12px rgba(74,111,165,.15)}
[data-theme="dark"] .pub-card{background:rgba(139,173,212,.06);border-left-color:#8badd4}
[data-theme="dark"] .pub-card:hover{background:rgba(139,173,212,.14)}
.pub-card .journal{font-style:italic;color:#4a6fa5;font-weight:500}
[data-theme="dark"] .pub-card .journal{color:#8badd4}
.pub-num{display:inline-block;background:#4a6fa5;color:#fff;font-weight:600;width:22px;height:22px;border-radius:50%;text-align:center;line-height:22px;font-size:.82em;margin-right:8px;font-style:normal;vertical-align:middle}
[data-theme="dark"] .pub-num{background:#6b8dc7}

/* ========== BADGES ========== */
.tag{display:inline-block;font-size:.75em;padding:2px 9px;border-radius:10px;margin-left:4px;font-weight:600;letter-spacing:.3px;transition:transform .2s;background:#f0c040;color:#333}
